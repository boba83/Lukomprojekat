# Gmail nalog koji ŠALJE poruke
SMTP_USER=lukomdelovi@gmail.com
# Google App Password (16 znakova, ne lozinka od naloga!)
SMTP_PASS=xxxxxxxxxxxxxxxx

# Adresa koja se prikazuje kao pošiljalac (može biti isti SMTP_USER)
MAIL_FROM="LUKOM sajt <lukomdelovi@gmail.com>"

# Gde stižu poruke sa sajta (boba/lukom inbox)
MAIL_TO=lukom@mts.rs

# (opciono) host/port — default je Gmail SSL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# (opciono) port API servera
PORT=3001

# (opciono, SAMO za lokalni razvoj iza antivirus/firewall-a koji presreće TLS)
# SMTP_INSECURE_TLS=true

# (opciono) dozvoli CORS samo sa konkretnog domena u produkciji
# ALLOWED_ORIGIN=https://www.lukom.rs

# Front-end (Vite) — gde forma šalje POST. Default je localhost:3001 u dev-u.
# VITE_API_URL=https://api.lukom.rs
